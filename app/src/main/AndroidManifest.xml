<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Core permissions needed for this first release: mic input + network to our own proxy. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.INTERNET" />

    <!--
        Future modules (see README "Roadmap") will each request their OWN narrow permission,
        at the time that feature is enabled, with a clear in-app explanation, e.g.:
          - Phone-control module -> android.permission.CALL_PHONE / telecom APIs (user-initiated actions only)
          - Incoming-call assistant -> android.permission.ANSWER_PHONE_CALLS + CallScreeningService,
            using Android's official Call Screening / Telecom APIs (no accessibility-service abuse)
          - WhatsApp workflows -> official WhatsApp Business Platform API from the backend, or
            Android's Intent/Share sheet from the client (no unofficial automation, no scraping,
            no Accessibility Service used to control WhatsApp's UI)
        Nothing here requests those permissions yet — they are added only when each module ships,
        and only via documented, publicly-supported Android APIs.
    -->

    <application
        android:name=".JyotiApplication"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Jyoti">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.Jyoti"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
