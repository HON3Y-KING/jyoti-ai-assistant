# Copy to .env (git-ignored). Never commit real values.
PORT=8080

# The actual AI provider secret key. Lives ONLY here, on the server. Never shipped in the app.
AI_PROVIDER_API_KEY=replace-with-real-key

# Shared secret the Android app sends so random internet traffic can't hit your proxy for free.
# This is a coarse gate, not real user auth — swap for per-user tokens (e.g. Firebase Auth)
# before going to production so you can revoke/rotate access per install.
APP_SHARED_SECRET=replace-with-a-long-random-string
